#!/usr/bin/env xdg-open
[Desktop Entry]
Type=Application
Version=1.0
Name=Toolbox Code-Backup
Name[de]=Toolbox Code-Backup
Comment=Creates and verifies a compressed backup of the Toolbox source code
Comment[de]=Erstellt und prüft ein komprimiertes Backup des Toolbox-Quellcodes
TryExec=/usr/bin/python3
Exec=/usr/bin/python3 -c "import os,sys; project_dir=os.path.dirname(sys.argv[1]); script=os.path.join(project_dir,'scripts/create_code_backup.sh'); os.execl(script,script)" %k
Icon=document-save
Terminal=false
Categories=Utility;
StartupNotify=false
